  "private": true,
  "description": "Sprachgesteuerter SKS-Lerncoach mit Leitner-System auf Basis des ELWIS-Fragenkatalogs",
  "type": "module",
  "scripts": {
    "import:elwis": "node scripts/import-elwis.mjs",
